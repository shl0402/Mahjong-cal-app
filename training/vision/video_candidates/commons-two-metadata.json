0 students.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2008","source":"commons-desc-page"},"Credit":{"value":"<a href=\"https://en.wikipedia.org/wiki/en:Global_Lives_Project\" class=\"extiw\" title=\"w:en:Global Lives Project\">Global Lives Project</a>","source":"commons-desc-page"},"Artist":{"value":"This video was produced by Ya-Hsuan Huang, Yi Han, Nobuhiro Awata, Irene Herrera, Bastien Robilliard, Hiroko Sumikura, Fang Liang, David Evan Harris, Chieko Kato, Major Tian, and <a href=\"https://en.wikipedia.org/wiki/Christina_Liu\" class=\"extiw\" title=\"en:Christina Liu\">Christina Liu</a>. This video is part of the Global Lives Project, a video library of life experience. For more information see globallives.org.","source":"commons-desc-page"},"Permission":{"value":"<a rel=\"nofollow\" class=\"external free\" href=\"https://globallives.org/en/license/\">https://globallives.org/en/license/</a>","source":"commons-desc-page","hidden":""},"LicenseShortName":{"value":"CC BY-SA 3.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution-Share Alike 3.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by-sa/3.0","source":"commons-desc-page"},"Copyrighted":{"value":"True","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"cc-by-sa-3.0","source":"commons-templates","hidden":""}}}]},"74794134":{"pageid":74794134,"ns":6,"title":"File:11\u670820\u65e5\u653e\u9001\u300c\u7b2c\uff11\u56de \u30cb\u30b3\u30d7\u30ed\u9ebb\u96c0\u738b\u6c7a\u5b9a\u6226\u300d\u548c\u7530\u4eac\u5e73\u30ec\u30d5\u30a7\u30ea\u30fc\u5727\u5dfb\u306e\u56db\u6697\u523b\u5358\u9a0e\u548c\u4e86\uff01.webm","imagerepository":"local","imageinfo":[{"timestamp":"2018-12-02T03:15:30Z","size":248832432,"width":1920,"height":1080,"duration":380.30400000000003